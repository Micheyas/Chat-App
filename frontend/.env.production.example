# Copy this file to .env.production before building a released Android app.
# Use your deployed backend URL, not localhost or a Wi-Fi IP.
VITE_BACKEND_URL=https://your-backend-domain.com

# Optional but strongly recommended for reliable calls between mobile networks.
# Example: turn:your-turn-domain.com:3478,t turns:your-turn-domain.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Required if file uploads are enabled.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
